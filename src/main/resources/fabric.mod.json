{
  "schemaVersion": 1,
  "id": "mehburs_minimap",
  "version": "${version}",
  "name": "Mehbur's Mini Map",
  "description": "A client-side 3D minimap with color-coded entity dots, an animated full-screen map and death markers.",
  "authors": ["Mehbur07"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["com.mehbur.minimap.MehbursMiniMapClient"],
    "modmenu": ["com.mehbur.minimap.config.ModMenuIntegration"]
  },
  "mixins": ["mehburs_minimap.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*",
    "cloth-config": "*"
  }
}
